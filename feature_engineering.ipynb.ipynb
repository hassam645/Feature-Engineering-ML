import pandas as pd
from sklearn.preprocessing import OrdinalEncoder
df = pd.DataFrame({'size': ['small', 'large', 'medium', 'medium', 'small', 'large']})
df
encoder=OrdinalEncoder(categories=[['small','medium','large']])
encoder.fit_transform(df[['size']])
encoder.fit_transform([['small']])
encoder.fit_transform([['medium']])
encoder.fit_transform([['large']])
df=pd.DataFrame({'city':['Multan','Lahore','Karachi','Islamabad'],'price':[123,645,786,999]})
df
mean_price=df.groupby('city')['price'].mean().to_dict()
mean_price
df['city_encoded']=df['city'].map(mean_price)
df
df[['city','city_encoded']]
df[['price','city_encoded']]
